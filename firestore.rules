rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to authenticated users for participants collection
    match /participants/{document=**} {
      allow read: if request.auth != null;
    }

    // Allow anyone to read/write pendingRegistrants (for registration)
    match /pendingRegistrants/{document=**} {
      allow read, write: if true;
    }

    // Allow anyone to read validatedPendingAttendants (registration checks this before user is created)
    // Allow authenticated users to write (admins adding new validated attendants)
    match /validatedPendingAttendants/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read/write authorizedUsers
    match /authorizedUsers/{userId} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users to read their own attendant document
    match /attendants/{attendantId} {
      allow read: if request.auth != null && request.auth.uid == attendantId;
    }

    // Allow creation of new attendant documents (for registration)
    match /attendants/{attendantId} {
      allow create: if request.resource.data.size() <= 10 &&
                     request.resource.data.keys().hasAll(['id', 'name', 'emailAddress', 'congregationName', 'congregationID', 'dateRegistered']);
    }
  }
}